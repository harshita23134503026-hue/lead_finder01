# LinkedIn API Configuration
# Get your access token from https://linkedin.com/developers
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here
LINKEDIN_ACCESS_TOKEN=your_access_token_here

# Hunter.io API Configuration
# Get your API key from https://hunter.io/
HUNTER_API_KEY=your_hunter_api_key_here
HUNTER_RATE_LIMIT_PER_HOUR=50
HUNTER_RATE_LIMIT_PER_DAY=400

# Gmail Configuration
# Generate app password from https://myaccount.google.com/apppasswords
GMAIL_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# SendGrid Configuration
# Get API key from https://sendgrid.com/
SENDGRID_API_KEY=SG.your_api_key_here

# Credit System
INITIAL_CREDITS=1000

# Campaign Settings
RATE_LIMIT_PER_HOUR=50
RATE_LIMIT_PER_DAY=400
MIN_QUALITY_SCORE=60.0
ENABLE_PROXY_ROTATION=false
ENABLE_HUMAN_BEHAVIOR=true
